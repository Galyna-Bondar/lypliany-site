---
import Base from '../../layouts/Base.astro';
import { themes, thumb, countLabel } from '../../lib/photos';
const total = themes.reduce((n, t) => n + t.photos.length, 0);
---
<Base title="Фотоальбом" description="Фотоальбом села Липляни: старі й сучасні світлини, розкладені за темами, з підписами автора.">
  <div class="mx-auto max-w-5xl px-4 pt-10">
    <h1 class="font-serif font-bold text-3xl md:text-4xl text-ink">Фотоальбом</h1>
    <p class="mt-3 text-lg text-ink max-w-2xl">
      {total} світлин у {themes.length} темах. Натисніть на тему, щоб переглянути фото й завантажити їх.
      Нумерація тем відповідає розділу 6 книги.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {themes.map((t) => (
        <a href={`/foto/${t.slug}/`} class="block rounded-lg border border-line bg-paper overflow-hidden hover:bg-linen focus-visible:outline-4 focus-visible:outline-accent">
          <img
            src={thumb(t.photos[0])}
            width={t.photos[0].tw}
            height={t.photos[0].th}
            alt=""
            loading="lazy"
            decoding="async"
            class="w-full aspect-[4/3] object-contain bg-linen"
          />
          <div class="p-4">
            <p class="text-sm text-muted">Розділ {t.ref}</p>
            <h2 class="font-serif font-bold text-xl text-ink leading-snug">{t.title}</h2>
            <p class="mt-1 text-muted">{countLabel(t.photos.length)}</p>
          </div>
        </a>
      ))}
    </div>

    <p class="mt-10 text-muted max-w-2xl">
      Усі матеріали книги разом (фото, аудіо, відео) можна завантажити з
      <a class="text-accent underline underline-offset-4" href="/media">Google Диска</a>.
    </p>
  </div>
</Base>
