---
import { bookPdf } from '../lib/book-pdf';
import Base from '../layouts/Base.astro';

const sections = [
  { href: '/kniha/', title: 'Книга', text: 'Читайте онлайн за розділами: історія краю, життя села у 20 столітті, долі людей, урочища.' },
  { href: '/foto/', title: 'Фотоальбом', text: 'Старі й сучасні світлини, розкладені за темами.' },
  { href: '/audio/', title: 'Голоси старожилів', text: 'Аудіоінтерв’ю з жителями села, пісні й танці.' },
  { href: '/video/', title: 'Відео', text: 'Відеокліпи про наше рідне село.' },
];

const facts = [
  { n: '1624', t: 'рік першої згадки в церковних записах' },
  { n: '920', t: 'жителів у 1923 році (171 двір)' },
  { n: '≈250', t: 'жителів нині' },
];
---
<Base>
  <section class="bg-linen border-b border-line">
    <div class="mx-auto max-w-5xl px-4 py-14 md:py-20">
      <p class="font-semibold text-accent tracking-wide uppercase text-sm">Житомирська область · Коростенський район</p>
      <h1 class="font-serif font-bold text-ink leading-tight mt-3 text-4xl md:text-6xl">
        Село Липляни
        <span class="block text-2xl md:text-4xl font-semibold text-muted mt-2">у спогадах старожилів</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink">
        Історія села в біографічних розповідях і особистих спогадах його мешканців.
        До книги додаються фотоальбом, аудіозаписи й відео.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/kniha/" class="bg-accent text-accent-ink font-semibold px-6 py-3 rounded hover:opacity-90">Читати книгу</a>
        {bookPdf && (
          <a href={bookPdf.href} download class="border-2 border-accent text-accent font-semibold px-6 py-3 rounded hover:bg-paper">Скачати книгу (PDF, {bookPdf.sizeMb} МБ)</a>
        )}
        <a href="https://lypliany-spohady.com.ua/media" class="border-2 border-accent text-accent font-semibold px-6 py-3 rounded hover:bg-paper">Завантажити матеріали</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 mt-12">
    <h2 class="font-serif font-bold text-2xl text-ink">Що тут є</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {sections.map((s) => (
        <a href={s.href} class="block rounded-lg border border-line bg-paper p-5 hover:bg-linen">
          <h3 class="font-serif font-bold text-xl text-ink">{s.title}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
          <span class="mt-3 inline-block font-semibold text-accent">Відкрити →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 mt-14">
    <h2 class="font-serif font-bold text-2xl text-ink">Про село</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      {facts.map((f) => (
        <div class="rounded-lg bg-linen p-5">
          <div class="font-serif font-bold text-4xl text-accent">{f.n}</div>
          <div class="mt-1 text-ink">{f.t}</div>
        </div>
      ))}
    </div>
    <p class="mt-5 max-w-2xl text-ink">
      Липляни належать до Чоповицької громади. Жителі вимовляють назву з апострофом, «Лип’яни»,
      а себе називають лип’янцями.
    </p>
  </section>
</Base>
